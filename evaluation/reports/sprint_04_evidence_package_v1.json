          "content_role": "untrusted_source_data",
          "passages": [
            {
              "citation_id": "knowledge-8c190344cead1896a62f14e518e9597a8812f5950368d05e3da470fe3a1d3a41",
              "text": "# Evidence checks\nCompare caller failures with Payment request durations and dependency spans from the same authorized window. Check deployment/configuration history, timestamps, effective timeout configuration and work duration separately. Preserve exact error codes such as HTTP 504 and /v1/orders without rewriting them. A nearby deployment can be unrelated.\n\n"
            },
            {
              "citation_id": "knowledge-c7adc8b40b9226d26d6282d72e9e21f9836c19455e2bbece6e9a58e38f9f2060",
              "text": "# Scope\nA timeout reports a caller-visible deadline failure. It does not identify which dependency or configuration caused the delay. Record service, environment, incident window and the authorized evidence sources before investigating.\n\n"
            },
            {
              "citation_id": "knowledge-5aa72db133d2f487efa43aa9efaaa60e6f6a40f22e143c76ffd637a446515281",
              "text": "# Boundary\nThe Payment development fixture receives an order ID and positive amount. The work result and the caller's configured deadline are separate observations. The fixture makes no real charge.\n\n"
            },
            {
              "citation_id": "knowledge-edb59c3d06f15039008e7d79dbf0d12786ce4876585215c63ea282dc05a163b7",
              "text": "# Observations\nIn this example, Payment requests failed during a certificate rollover. The archive retained a TLS certificate expiry error, the certificate validity interval and a dependency trace. A nearby Notification rollout was initially considered, but its records did not support a causal connection.\n\n"
            },
            {
              "citation_id": "knowledge-ed0dfd079c8892c5fc318184c3a44a8c411b6f7c47e8a39e96cf3545ddebf810",
              "text": "# Evidence vocabulary\nUseful evidence can include request failures, measured work duration, effective caller budget and configuration revisions. Keep each source's record identity, version, service, environment and observed time when joining a request timeline. HTTP 504 is a symptom code, not a root-cause label.\n\n"
            }
          ],
          "schema_version": "1"
        },
